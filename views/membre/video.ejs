<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= video.title %> — Les Collines</title>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;900&family=Barlow:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root { --lime:#c8f700; --black:#080808; --dark:#111; --card:#161616; --border:#222; --white:#fff; --muted:#666; --font-h:'Barlow Condensed',sans-serif; --font-b:'Barlow',sans-serif; }
    body { background: var(--black); color: var(--white); font-family: var(--font-b); min-height: 100vh; }
    a { text-decoration: none; color: inherit; }
    .header { position: sticky; top: 0; z-index: 30; background: rgba(8,8,8,.95); backdrop-filter: blur(12px); border-bottom: 1px solid var(--border); padding: 0 2rem; height: 64px; display: flex; align-items: center; justify-content: space-between; }
    .header-logo { font-family: var(--font-h); font-size: 1.3rem; font-weight: 900; color: var(--lime); text-transform: uppercase; }
    .header-badge { font-family: var(--font-h); font-size: .6rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); }
    .back-btn { display: inline-flex; align-items: center; gap: .5rem; color: var(--muted); font-family: var(--font-h); font-size: .8rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; transition: color .2s; }
    .back-btn:hover { color: var(--lime); }
    .back-btn svg { width: 16px; height: 16px; }
    .main { max-width: 960px; margin: 0 auto; padding: 2.5rem 2rem 5rem; }
    .video-header { margin-bottom: 1.5rem; }
    .video-cat { font-family: var(--font-h); font-size: .7rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: var(--lime); margin-bottom: .6rem; }
    .video-title { font-family: var(--font-h); font-size: clamp(1.8rem,4vw,3rem); font-weight: 900; text-transform: uppercase; line-height: 1; margin-bottom: .6rem; }
    .video-date { font-size: .8rem; color: var(--muted); }
    /* Player */
    .player-wrap { position: relative; aspect-ratio: 16/9; background: #000; border-radius: 6px; overflow: hidden; margin-bottom: 1.5rem; border: 1px solid var(--border); }
    .player-wrap iframe, .player-wrap video { position: absolute; inset: 0; width: 100%; height: 100%; border: none; }
    .video-desc { color: #aaa; font-size: .95rem; line-height: 1.7; border-top: 1px solid var(--border); padding-top: 1.5rem; }
    @media (max-width: 480px) { .main { padding: 1.5rem 1rem 4rem; } }
  </style>
</head>
<body>
  <header class="header">
    <div>
      <div class="header-logo">Les Collines</div>
      <div class="header-badge">Espace Adhérents</div>
    </div>
    <a href="/membre/dashboard" class="back-btn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
      Retour
    </a>
  </header>

  <main class="main">
    <div class="video-header">
      <div class="video-cat"><%= video.category %></div>
      <h1 class="video-title"><%= video.title %></h1>
      <div class="video-date">Ajouté le <%= new Date(video.createdAt).toLocaleDateString('fr-FR', { day:'numeric', month:'long', year:'numeric' }) %></div>
    </div>

    <div class="player-wrap">
      <% if (video.youtubeId) { %>
        <iframe
          src="https://www.youtube.com/embed/<%= video.youtubeId %>?autoplay=0&rel=0&modestbranding=1"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
          title="<%= video.title %>"
        ></iframe>
      <% } else if (video.file) { %>
        <video controls preload="metadata">
          <source src="<%= video.file %>" />
          Votre navigateur ne supporte pas la lecture vidéo.
        </video>
      <% } %>
    </div>

    <% if (video.description) { %>
      <div class="video-desc"><%= video.description %></div>
    <% } %>
  </main>
</body>
</html>
