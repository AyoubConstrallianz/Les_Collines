<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= programme.title %> — Les Collines</title>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;900&family=Barlow:wght@400;500&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root { --lime:#c8f700; --black:#080808; --dark:#111; --card:#161616; --border:#222; --white:#fff; --muted:#666; --font-h:'Barlow Condensed',sans-serif; }
    body { background: var(--black); color: var(--white); font-family: 'Barlow', sans-serif; min-height: 100vh; }
    a { text-decoration: none; color: inherit; }
    .header { position: sticky; top: 0; z-index: 30; background: rgba(8,8,8,.95); backdrop-filter: blur(12px); border-bottom: 1px solid var(--border); padding: 0 2rem; height: 64px; display: flex; align-items: center; justify-content: space-between; }
    .header-logo { font-family: var(--font-h); font-size: 1.3rem; font-weight: 900; color: var(--lime); text-transform: uppercase; }
    .header-badge { font-family: var(--font-h); font-size: .6rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); }
    .back-btn { display: inline-flex; align-items: center; gap: .5rem; color: var(--muted); font-family: var(--font-h); font-size: .8rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; transition: color .2s; }
    .back-btn:hover { color: var(--lime); }
    .back-btn svg { width: 16px; height: 16px; }
    .main { max-width: 960px; margin: 0 auto; padding: 2.5rem 2rem 5rem; }
    .prog-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 2rem; margin-bottom: 2rem; flex-wrap: wrap; }
    .prog-meta { flex: 1; }
    .prog-cat { font-family: var(--font-h); font-size: .7rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: var(--lime); margin-bottom: .6rem; }
    .prog-title { font-family: var(--font-h); font-size: clamp(1.8rem,4vw,3rem); font-weight: 900; text-transform: uppercase; line-height: 1; margin-bottom: .6rem; }
    .prog-date { font-size: .8rem; color: var(--muted); }
    .prog-actions { display: flex; gap: .6rem; flex-shrink: 0; }
    .btn { display: inline-flex; align-items: center; gap: .5rem; font-family: var(--font-h); font-size: .8rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; padding: .65rem 1.2rem; border-radius: 4px; cursor: pointer; transition: all .2s; }
    .btn-primary { background: var(--lime); color: var(--black); border: none; }
    .btn-primary:hover { opacity: .85; }
    .btn-outline { background: none; color: var(--white); border: 1px solid var(--border); }
    .btn-outline:hover { border-color: var(--lime); color: var(--lime); }
    .btn svg { width: 14px; height: 14px; }
    /* PDF / image viewer */
    .viewer { border: 1px solid var(--border); border-radius: 6px; overflow: hidden; background: #000; }
    .pdf-frame { width: 100%; height: 80vh; border: none; display: block; }
    .img-viewer { width: 100%; display: block; max-height: 85vh; object-fit: contain; }
    .no-preview { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 4rem; gap: 1rem; color: var(--muted); }
    .no-preview svg { width: 56px; height: 56px; opacity: .3; }
    .no-preview p { font-family: var(--font-h); letter-spacing: .1em; text-transform: uppercase; font-size: .9rem; }
    @media (max-width: 480px) { .main { padding: 1.5rem 1rem 4rem; } .prog-actions { flex-direction: column; } }
  </style>
</head>
<body>
  <header class="header">
    <div>
      <div class="header-logo">Les Collines</div>
      <div class="header-badge">Espace Adhérents</div>
    </div>
    <a href="/membre/dashboard" class="back-btn">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 5l-7 7 7 7"/></svg>
      Retour
    </a>
  </header>

  <main class="main">
    <div class="prog-header">
      <div class="prog-meta">
        <div class="prog-cat"><%= programme.category %></div>
        <h1 class="prog-title"><%= programme.title %></h1>
        <div class="prog-date">Ajouté le <%= new Date(programme.createdAt).toLocaleDateString('fr-FR', { day:'numeric', month:'long', year:'numeric' }) %></div>
        <% if (programme.description) { %>
          <p style="color:#aaa;font-size:.9rem;line-height:1.6;margin-top:.8rem;"><%= programme.description %></p>
        <% } %>
      </div>
      <div class="prog-actions">
        <a href="<%= programme.file %>" download class="btn btn-primary">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Télécharger
        </a>
        <a href="<%= programme.file %>" target="_blank" class="btn btn-outline">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
          Ouvrir
        </a>
      </div>
    </div>

    <div class="viewer">
      <% if (programme.fileExt === '.pdf') { %>
        <iframe class="pdf-frame" src="<%= programme.file %>#toolbar=1" title="<%= programme.title %>"></iframe>
      <% } else if (['.jpg','.jpeg','.png','.webp'].includes(programme.fileExt)) { %>
        <img class="img-viewer" src="<%= programme.file %>" alt="<%= programme.title %>" />
      <% } else { %>
        <div class="no-preview">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          <p>Aperçu non disponible</p>
          <a href="<%= programme.file %>" download class="btn btn-primary" style="margin-top:.5rem;">Télécharger le fichier</a>
        </div>
      <% } %>
    </div>
  </main>
</body>
</html>
