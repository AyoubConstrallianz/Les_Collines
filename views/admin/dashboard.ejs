<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard Admin — Les Collines des Sports</title>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;900&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root { --lime:#c8f700; --black:#080808; --dark:#111; --card:#161616; --border:#222; --white:#fff; --muted:#888; --red:#ff4444; --green:#22c55e; }
    body { background: var(--black); color: var(--white); font-family: 'Barlow', sans-serif; min-height: 100vh; }

    /* ── Sidebar ── */
    .layout { display: flex; min-height: 100vh; }
    .sidebar {
      width: 240px; flex-shrink: 0; background: var(--dark); border-right: 1px solid var(--border);
      display: flex; flex-direction: column; position: fixed; top: 0; left: 0; height: 100vh; overflow-y: auto; z-index: 30;
    }
    .sidebar-logo { padding: 1.8rem 1.5rem; border-bottom: 1px solid var(--border); }
    .sidebar-logo .brand { font-family: 'Barlow Condensed', sans-serif; font-size: 1.4rem; font-weight: 900; color: var(--lime); text-transform: uppercase; }
    .sidebar-logo .sub { font-size: .65rem; color: var(--muted); letter-spacing: .15em; text-transform: uppercase; margin-top: 2px; }
    .sidebar-nav { padding: 1.2rem 0; flex: 1; }
    .nav-section { padding: .5rem 1.5rem .3rem; font-size: .6rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); }
    .nav-item { display: flex; align-items: center; gap: .75rem; padding: .7rem 1.5rem; font-size: .85rem; font-weight: 500; color: var(--muted); cursor: pointer; text-decoration: none; transition: all .2s; }
    .nav-item:hover { color: var(--white); background: rgba(255,255,255,.04); }
    .nav-item.active { color: var(--lime); background: rgba(200,247,0,.06); border-right: 2px solid var(--lime); }
    .nav-item svg { width: 16px; height: 16px; flex-shrink: 0; }
    .sidebar-footer { padding: 1.2rem 1.5rem; border-top: 1px solid var(--border); }
    .btn-logout { display: flex; align-items: center; gap: .6rem; width: 100%; background: none; border: 1px solid var(--border); color: var(--muted); font-family: 'Barlow', sans-serif; font-size: .8rem; padding: .6rem 1rem; border-radius: 4px; cursor: pointer; text-decoration: none; transition: all .2s; }
    .btn-logout:hover { border-color: var(--red); color: var(--red); }
    .btn-logout svg { width: 14px; height: 14px; }

    /* ── Main ── */
    .main { margin-left: 240px; flex: 1; padding: 2.5rem; max-width: calc(100vw - 240px); }
    .page-header { margin-bottom: 2.5rem; }
    .page-header h1 { font-family: 'Barlow Condensed', sans-serif; font-size: 2rem; font-weight: 900; text-transform: uppercase; }
    .page-header p { color: var(--muted); font-size: .9rem; margin-top: .3rem; }

    /* ── Toast ── */
    .toast { display: flex; align-items: center; gap: .75rem; background: rgba(34,197,94,.1); border: 1px solid rgba(34,197,94,.3); color: #4ade80; padding: .9rem 1.2rem; border-radius: 4px; margin-bottom: 1.8rem; font-size: .9rem; }
    .toast svg { width: 18px; height: 18px; flex-shrink: 0; }

    /* ── Cards ── */
    .cards-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem; }
    .card { background: var(--dark); border: 1px solid var(--border); border-radius: 6px; overflow: hidden; }
    .card-header { padding: 1.2rem 1.5rem; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: .75rem; }
    .card-icon { width: 36px; height: 36px; background: rgba(200,247,0,.08); border-radius: 4px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .card-icon svg { width: 18px; height: 18px; color: var(--lime); }
    .card-title { font-family: 'Barlow Condensed', sans-serif; font-size: 1rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
    .card-body { padding: 1.5rem; }

    /* ── Form ── */
    .form-group { margin-bottom: 1.2rem; }
    .form-group:last-child { margin-bottom: 0; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    label { display: block; font-size: .7rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin-bottom: .4rem; }
    input[type="text"], input[type="email"], textarea {
      width: 100%; background: var(--card); border: 1px solid var(--border); color: var(--white);
      padding: .7rem .9rem; font-family: 'Barlow', sans-serif; font-size: .9rem; border-radius: 4px;
      transition: border-color .2s; outline: none; resize: vertical;
    }
    input:focus, textarea:focus { border-color: var(--lime); }
    textarea { min-height: 100px; }
    .btn-save { display: inline-flex; align-items: center; gap: .5rem; background: var(--lime); color: var(--black); font-family: 'Barlow Condensed', sans-serif; font-size: .85rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; padding: .65rem 1.4rem; border: none; border-radius: 4px; cursor: pointer; transition: opacity .2s; margin-top: 1rem; }
    .btn-save:hover { opacity: .85; }
    .btn-save svg { width: 15px; height: 15px; }
    .btn-danger { display: inline-flex; align-items: center; gap: .5rem; background: rgba(255,68,68,.1); color: var(--red); border: 1px solid rgba(255,68,68,.3); font-family: 'Barlow Condensed', sans-serif; font-size: .8rem; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; padding: .55rem 1rem; border-radius: 4px; cursor: pointer; transition: all .2s; }
    .btn-danger:hover { background: rgba(255,68,68,.2); }
    .btn-danger svg { width: 14px; height: 14px; }
    .field-hint { font-size: .75rem; color: var(--muted); margin-top: .3rem; }

    /* ── Logo preview ── */
    .logo-preview { display: flex; align-items: center; gap: 1.2rem; margin-bottom: 1.2rem; }
    .logo-thumb { width: 120px; height: 60px; object-fit: contain; background: #000; border: 1px solid var(--border); border-radius: 4px; padding: 4px; }
    .logo-placeholder { width: 120px; height: 60px; background: var(--card); border: 1px solid var(--border); border-radius: 4px; display: flex; align-items: center; justify-content: center; }
    .logo-placeholder svg { width: 28px; height: 28px; color: var(--muted); }
    .logo-actions { display: flex; flex-direction: column; gap: .6rem; }
    .file-input-label { display: inline-flex; align-items: center; gap: .5rem; background: var(--card); border: 1px solid var(--border); color: var(--white); font-family: 'Barlow Condensed', sans-serif; font-size: .8rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; padding: .55rem 1rem; border-radius: 4px; cursor: pointer; transition: all .2s; }
    .file-input-label:hover { border-color: var(--lime); color: var(--lime); }
    .file-input-label svg { width: 14px; height: 14px; }
    input[type="file"] { display: none; }

    /* ── View site link ── */
    .view-site { display: inline-flex; align-items: center; gap: .5rem; background: rgba(200,247,0,.08); border: 1px solid rgba(200,247,0,.2); color: var(--lime); font-family: 'Barlow Condensed', sans-serif; font-size: .8rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; padding: .5rem 1rem; border-radius: 4px; text-decoration: none; transition: all .2s; margin-left: 1rem; }
    .view-site:hover { background: rgba(200,247,0,.15); }
    .view-site svg { width: 14px; height: 14px; }

    /* ── Responsive ── */
    @media (max-width: 768px) {
      .sidebar { display: none; }
      .main { margin-left: 0; max-width: 100vw; padding: 1.5rem; }
      .form-row { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
<div class="layout">

  <!-- ── Sidebar ── -->
  <aside class="sidebar">
    <div class="sidebar-logo">
      <div class="brand">Les Collines</div>
      <div class="sub">Administration</div>
    </div>
    <nav class="sidebar-nav">
      <div class="nav-section">Gestion</div>
      <a href="#logo" class="nav-item active">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
        Logo
      </a>
      <a href="#contact" class="nav-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 10.8 19.79 19.79 0 01.1 2.18 2 2 0 012.1 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
        Contact
      </a>
      <a href="#social" class="nav-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
        Réseaux sociaux
      </a>
      <a href="#services" class="nav-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
        Services
      </a>
      <a href="#sports" class="nav-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8h1a4 4 0 010 8h-1"/><path d="M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
        Sports
      </a>
    </nav>
    <div class="sidebar-footer">
      <a href="/" target="_blank" class="btn-logout" style="margin-bottom:.6rem;border-color:rgba(200,247,0,.2);color:var(--lime);">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        Voir le site
      </a>
      <a href="/admin/logout" class="btn-logout">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Déconnexion
      </a>
    </div>
  </aside>

  <!-- ── Main ── -->
  <main class="main">
    <div class="page-header">
      <h1>Tableau de bord</h1>
      <p>Gérez les informations affichées sur votre site web.</p>
    </div>

    <% if (success) { %>
      <div class="toast">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
        <span>
          <% if (success === 'contact') { %>Informations de contact mises à jour avec succès.
          <% } else if (success === 'social') { %>Réseaux sociaux mis à jour avec succès.
          <% } else if (success === 'logo') { %>Logo mis à jour avec succès.
          <% } else if (success === 'services') { %>Services mis à jour avec succès.
          <% } else if (success === 'sports') { %>Sports mis à jour avec succès.
          <% } else { %>Modifications enregistrées.<% } %>
        </span>
      </div>
    <% } %>

    <div class="cards-grid">

      <!-- ── Logo ── -->
      <div class="card" id="logo">
        <div class="card-header">
          <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg></div>
          <div class="card-title">Logo du site</div>
        </div>
        <div class="card-body">
          <div class="logo-preview">
            <% if (site.logo) { %>
              <img src="<%= site.logo %>" alt="Logo actuel" class="logo-thumb" />
            <% } else { %>
              <div class="logo-placeholder">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              </div>
            <% } %>
            <div class="logo-actions">
              <form method="POST" action="/admin/update-logo" enctype="multipart/form-data">
                <label for="logoFile" class="file-input-label">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                  Choisir un fichier
                </label>
                <input type="file" id="logoFile" name="logo" accept="image/*" onchange="this.form.submit()" />
              </form>
              <% if (site.logo) { %>
                <form method="POST" action="/admin/remove-logo" onsubmit="return confirm('Supprimer le logo ?')">
                  <button type="submit" class="btn-danger">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/><path d="M10 11v6M14 11v6"/></svg>
                    Supprimer
                  </button>
                </form>
              <% } %>
            </div>
          </div>
          <p class="field-hint">Formats acceptés : JPG, PNG, SVG, WEBP — max 5 Mo</p>
        </div>
      </div>

      <!-- ── Contact ── -->
      <div class="card" id="contact">
        <div class="card-header">
          <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 10.8 19.79 19.79 0 01.1 2.18 2 2 0 012.1 0h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg></div>
          <div class="card-title">Contact</div>
        </div>
        <div class="card-body">
          <form method="POST" action="/admin/update-contact">
            <div class="form-row">
              <div class="form-group">
                <label for="phone1">Téléphone 1</label>
                <input type="text" id="phone1" name="phone1" value="<%= site.phones[0] || '' %>" placeholder="06 XX XX XX XX" />
              </div>
              <div class="form-group">
                <label for="phone2">Téléphone 2</label>
                <input type="text" id="phone2" name="phone2" value="<%= site.phones[1] || '' %>" placeholder="06 XX XX XX XX" />
              </div>
            </div>
            <div class="form-group">
              <label for="email">Email</label>
              <input type="email" id="email" name="email" value="<%= site.email %>" />
            </div>
            <div class="form-group">
              <label for="address">Adresse</label>
              <input type="text" id="address" name="address" value="<%= site.address %>" />
            </div>
            <button type="submit" class="btn-save">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
              Enregistrer
            </button>
          </form>
        </div>
      </div>

      <!-- ── Réseaux sociaux ── -->
      <div class="card" id="social">
        <div class="card-header">
          <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg></div>
          <div class="card-title">Réseaux sociaux</div>
        </div>
        <div class="card-body">
          <form method="POST" action="/admin/update-social">
            <div class="form-group">
              <label for="instagram">Instagram (sans @)</label>
              <input type="text" id="instagram" name="instagram" value="<%= site.social.instagram %>" placeholder="lescollines.fitness" />
            </div>
            <div class="form-group">
              <label for="snapchat">Snapchat</label>
              <input type="text" id="snapchat" name="snapchat" value="<%= site.social.snapchat %>" placeholder="lescollinesfitn" />
            </div>
            <div class="form-group">
              <label for="tiktok">TikTok</label>
              <input type="text" id="tiktok" name="tiktok" value="<%= site.social.tiktok %>" placeholder="@lescollines.fitness" />
            </div>
            <button type="submit" class="btn-save">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
              Enregistrer
            </button>
          </form>
        </div>
      </div>

      <!-- ── Services ── -->
      <div class="card" id="services">
        <div class="card-header">
          <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg></div>
          <div class="card-title">Services proposés</div>
        </div>
        <div class="card-body">
          <form method="POST" action="/admin/update-services">
            <div class="form-group">
              <label for="services">Un service par ligne</label>
              <textarea id="services" name="services" rows="6"><%= site.services.join('\n') %></textarea>
              <p class="field-hint">Affiché dans le bandeau hero et le ticker du site.</p>
            </div>
            <button type="submit" class="btn-save">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
              Enregistrer
            </button>
          </form>
        </div>
      </div>

      <!-- ── Sports (full width) ── -->
      <div class="card" id="sports" style="grid-column: 1 / -1;">
        <div class="card-header">
          <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8h1a4 4 0 010 8h-1"/><path d="M2 8h16v9a4 4 0 01-4 4H6a4 4 0 01-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg></div>
          <div class="card-title">Disciplines sportives</div>
        </div>
        <div class="card-body">
          <form method="POST" action="/admin/update-sports">
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1rem;">
              <div class="form-group">
                <label for="martial">Arts Martiaux (1 par ligne)</label>
                <textarea id="martial" name="martial" rows="9"><%= (site.sports.martial||[]).join('\n') %></textarea>
              </div>
              <div class="form-group">
                <label for="fitness">Fitness & Performance (1 par ligne)</label>
                <textarea id="fitness" name="fitness" rows="9"><%= (site.sports.fitness||[]).join('\n') %></textarea>
              </div>
              <div class="form-group">
                <label for="wellbeing">Bien-Être (1 par ligne)</label>
                <textarea id="wellbeing" name="wellbeing" rows="9"><%= (site.sports.wellbeing||[]).join('\n') %></textarea>
              </div>
            </div>
            <button type="submit" class="btn-save">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
              Enregistrer les sports
            </button>
          </form>
        </div>
      </div>

    </div><!-- /cards-grid -->
  </main>
</div>

<script>
  // Active nav item on click
  document.querySelectorAll('.nav-item').forEach(item => {
    item.addEventListener('click', () => {
      document.querySelectorAll('.nav-item').forEach(i => i.classList.remove('active'));
      item.classList.add('active');
    });
  });
</script>
</body>
</html>
