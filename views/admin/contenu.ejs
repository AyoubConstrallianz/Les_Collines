<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contenu — Admin Les Collines</title>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;900&family=Barlow:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root { --lime:#c8f700; --black:#080808; --dark:#111; --card:#161616; --border:#222; --white:#fff; --muted:#888; --red:#ff4444; }
    body { background: var(--black); color: var(--white); font-family: 'Barlow', sans-serif; min-height: 100vh; display: flex; }

    /* Sidebar (same as adherents) */
    .sidebar { width: 240px; flex-shrink: 0; background: var(--dark); border-right: 1px solid var(--border); display: flex; flex-direction: column; position: fixed; top: 0; left: 0; height: 100vh; overflow-y: auto; z-index: 30; }
    .sidebar-logo { padding: 1.8rem 1.5rem; border-bottom: 1px solid var(--border); }
    .sidebar-logo .brand { font-family: 'Barlow Condensed', sans-serif; font-size: 1.4rem; font-weight: 900; color: var(--lime); text-transform: uppercase; }
    .sidebar-logo .sub { font-size: .65rem; color: var(--muted); letter-spacing: .15em; text-transform: uppercase; margin-top: 2px; }
    .sidebar-nav { padding: 1.2rem 0; flex: 1; }
    .nav-section { padding: .5rem 1.5rem .3rem; font-size: .6rem; font-weight: 700; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); }
    .nav-item { display: flex; align-items: center; gap: .75rem; padding: .7rem 1.5rem; font-size: .85rem; font-weight: 500; color: var(--muted); text-decoration: none; transition: all .2s; }
    .nav-item:hover { color: var(--white); background: rgba(255,255,255,.04); }
    .nav-item.active { color: var(--lime); background: rgba(200,247,0,.06); border-right: 2px solid var(--lime); }
    .nav-item svg { width: 16px; height: 16px; flex-shrink: 0; }
    .sidebar-footer { padding: 1.2rem 1.5rem; border-top: 1px solid var(--border); display: flex; flex-direction: column; gap: .6rem; }
    .btn-logout { display: flex; align-items: center; gap: .6rem; background: none; border: 1px solid var(--border); color: var(--muted); font-size: .8rem; padding: .6rem 1rem; border-radius: 4px; cursor: pointer; text-decoration: none; transition: all .2s; }
    .btn-logout:hover { border-color: var(--red); color: var(--red); }
    .btn-logout svg { width: 14px; height: 14px; }

    /* Main */
    .main { margin-left: 240px; flex: 1; padding: 2.5rem; }
    .page-header { margin-bottom: 2.5rem; }
    .page-header h1 { font-family: 'Barlow Condensed', sans-serif; font-size: 2rem; font-weight: 900; text-transform: uppercase; }
    .page-header p { color: var(--muted); font-size: .9rem; margin-top: .3rem; }

    /* Tabs */
    .tabs { display: flex; border-bottom: 1px solid var(--border); margin-bottom: 2rem; }
    .tab { font-family: 'Barlow Condensed', sans-serif; font-size: .85rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); padding: .9rem 1.8rem; cursor: pointer; border-bottom: 2px solid transparent; transition: all .25s; background: none; border-left: none; border-right: none; border-top: none; }
    .tab:hover { color: var(--white); }
    .tab.active { color: var(--lime); border-bottom-color: var(--lime); }
    .panel { display: none; }
    .panel.active { display: grid; grid-template-columns: 1fr 1.6fr; gap: 1.5rem; align-items: start; }

    /* Toast */
    .toast { display: flex; align-items: center; gap: .75rem; padding: .9rem 1.2rem; border-radius: 4px; margin-bottom: 1.8rem; font-size: .9rem; }
    .toast.success { background: rgba(34,197,94,.1); border: 1px solid rgba(34,197,94,.3); color: #4ade80; }
    .toast.error   { background: rgba(255,68,68,.1);  border: 1px solid rgba(255,68,68,.3);  color: #ff7070; }
    .toast svg { width: 18px; height: 18px; flex-shrink: 0; }

    /* Card */
    .card { background: var(--dark); border: 1px solid var(--border); border-radius: 6px; overflow: hidden; }
    .card-header { padding: 1.2rem 1.5rem; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: .75rem; }
    .card-icon { width: 36px; height: 36px; background: rgba(200,247,0,.08); border-radius: 4px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .card-icon svg { width: 18px; height: 18px; color: var(--lime); }
    .card-title { font-family: 'Barlow Condensed', sans-serif; font-size: 1rem; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; }
    .card-body { padding: 1.5rem; }

    /* Form */
    .form-group { margin-bottom: 1.1rem; }
    .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    label { display: block; font-size: .7rem; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin-bottom: .4rem; }
    input[type="text"], input[type="url"], textarea, select { width: 100%; background: var(--card); border: 1px solid var(--border); color: var(--white); padding: .7rem .9rem; font-family: 'Barlow', sans-serif; font-size: .9rem; border-radius: 4px; transition: border-color .2s; outline: none; }
    textarea { min-height: 70px; resize: vertical; }
    select option { background: var(--card); }
    input:focus, textarea:focus, select:focus { border-color: var(--lime); }
    .file-label { display: inline-flex; align-items: center; gap: .5rem; background: var(--card); border: 1px solid var(--border); color: var(--white); font-family: 'Barlow Condensed', sans-serif; font-size: .8rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; padding: .6rem 1rem; border-radius: 4px; cursor: pointer; transition: all .2s; }
    .file-label:hover { border-color: var(--lime); color: var(--lime); }
    .file-label svg { width: 14px; height: 14px; }
    input[type="file"] { display: none; }
    .file-name { font-size: .8rem; color: var(--muted); margin-top: .4rem; }
    .divider-or { display: flex; align-items: center; gap: 1rem; margin: 1rem 0; color: var(--muted); font-size: .75rem; letter-spacing: .1em; text-transform: uppercase; }
    .divider-or::before, .divider-or::after { content: ''; flex: 1; height: 1px; background: var(--border); }
    .btn-save { display: inline-flex; align-items: center; gap: .5rem; background: var(--lime); color: var(--black); font-family: 'Barlow Condensed', sans-serif; font-size: .85rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; padding: .65rem 1.4rem; border: none; border-radius: 4px; cursor: pointer; transition: opacity .2s; margin-top: 1rem; }
    .btn-save:hover { opacity: .85; }
    .btn-save svg { width: 15px; height: 15px; }
    .hint { font-size: .75rem; color: var(--muted); margin-top: .3rem; }

    /* Content list */
    .content-list { display: flex; flex-direction: column; gap: .8rem; }
    .content-item { background: var(--card); border: 1px solid var(--border); border-radius: 4px; padding: 1rem 1.2rem; display: flex; align-items: center; gap: 1rem; }
    .content-thumb { width: 80px; height: 45px; background: #000; border-radius: 3px; overflow: hidden; flex-shrink: 0; display: flex; align-items: center; justify-content: center; }
    .content-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .content-thumb svg { width: 22px; height: 22px; color: var(--muted); }
    .content-info { flex: 1; min-width: 0; }
    .content-title { font-family: 'Barlow Condensed', sans-serif; font-size: .95rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .content-meta { display: flex; align-items: center; gap: .6rem; margin-top: .25rem; }
    .content-cat { font-family: 'Barlow Condensed', sans-serif; font-size: .6rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--lime); background: rgba(200,247,0,.08); padding: .15rem .5rem; border-radius: 2px; }
    .content-date { font-size: .75rem; color: var(--muted); }
    .btn-del { display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; background: rgba(255,68,68,.08); border: 1px solid rgba(255,68,68,.15); color: var(--red); border-radius: 4px; cursor: pointer; transition: all .2s; flex-shrink: 0; }
    .btn-del:hover { background: rgba(255,68,68,.2); }
    .btn-del svg { width: 14px; height: 14px; }
    .empty { text-align: center; padding: 2rem; color: var(--muted); font-family: 'Barlow Condensed', sans-serif; font-size: .9rem; letter-spacing: .1em; text-transform: uppercase; border: 1px dashed var(--border); border-radius: 4px; }

    @media (max-width: 900px) { .panel.active { grid-template-columns: 1fr; } .sidebar { display: none; } .main { margin-left: 0; } }
  </style>
</head>
<body>
  <!-- Sidebar -->
  <aside class="sidebar">
    <div class="sidebar-logo"><div class="brand">Les Collines</div><div class="sub">Administration</div></div>
    <nav class="sidebar-nav">
      <div class="nav-section">Site</div>
      <a href="/admin/dashboard" class="nav-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
        Paramètres site
      </a>
      <div class="nav-section">Espace Adhérents</div>
      <a href="/admin/adherents" class="nav-item">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
        Adhérents
      </a>
      <a href="/admin/contenu" class="nav-item active">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>
        Vidéos & Programmes
      </a>
    </nav>
    <div class="sidebar-footer">
      <a href="/" target="_blank" class="btn-logout" style="border-color:rgba(200,247,0,.2);color:var(--lime);">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
        Voir le site
      </a>
      <a href="/admin/logout" class="btn-logout">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        Déconnexion
      </a>
    </div>
  </aside>

  <!-- Main -->
  <main class="main">
    <div class="page-header">
      <h1>Vidéos &amp; Programmes</h1>
      <p>Gérez le contenu disponible dans l'espace adhérents.</p>
    </div>

    <% if (success) { %>
      <div class="toast success">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
        <span>
          <% if (success === 'video') { %>Vidéo ajoutée avec succès.
          <% } else if (success === 'programme') { %>Programme ajouté avec succès.
          <% } else if (success === 'deleted') { %>Contenu supprimé.
          <% } else { %>Modification enregistrée.<% } %>
        </span>
      </div>
    <% } %>
    <% if (error) { %>
      <div class="toast error">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
        <% if (error === 'no_source') { %>Veuillez fournir une URL YouTube ou un fichier vidéo.
        <% } else if (error === 'invalid_url') { %>URL YouTube invalide.
        <% } else if (error === 'no_file') { %>Aucun fichier sélectionné.
        <% } else { %>Une erreur s'est produite.<% } %>
      </div>
    <% } %>

    <!-- Tabs -->
    <div class="tabs">
      <button class="tab active" data-tab="videos">Vidéos (<%= videos.length %>)</button>
      <button class="tab" data-tab="programmes">Programmes (<%= programs.length %>)</button>
    </div>

    <!-- ── VIDEOS PANEL ── -->
    <div class="panel active" id="tab-videos">
      <!-- Add form -->
      <div class="card">
        <div class="card-header">
          <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg></div>
          <div class="card-title">Ajouter une vidéo</div>
        </div>
        <div class="card-body">
          <form method="POST" action="/admin/contenu/add-video" enctype="multipart/form-data" id="videoForm">
            <div class="form-group">
              <label for="vtitle">Titre</label>
              <input type="text" id="vtitle" name="title" required placeholder="Séance MMA débutant" />
            </div>
            <div class="form-row">
              <div class="form-group">
                <label for="vcategory">Catégorie</label>
                <input type="text" id="vcategory" name="category" placeholder="Arts Martiaux" />
              </div>
            </div>
            <div class="form-group">
              <label for="vdesc">Description (optionnel)</label>
              <textarea id="vdesc" name="description" placeholder="Décrivez le contenu de la vidéo…"></textarea>
            </div>

            <label>Source de la vidéo</label>
            <div class="form-group" style="margin-bottom:.5rem;">
              <input type="url" id="youtubeUrl" name="youtubeUrl" placeholder="https://www.youtube.com/watch?v=..." />
              <p class="hint">Collez un lien YouTube ou Shorts</p>
            </div>
            <div class="divider-or">ou</div>
            <div class="form-group">
              <label for="videoFile" class="file-label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                Choisir un fichier vidéo
              </label>
              <input type="file" id="videoFile" name="videoFile" accept="video/*" onchange="document.getElementById('vFileName').textContent = this.files[0]?.name || ''" />
              <div class="file-name" id="vFileName">MP4, MOV, AVI — max 2 Go</div>
            </div>

            <button type="submit" class="btn-save">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              Ajouter la vidéo
            </button>
          </form>
        </div>
      </div>

      <!-- Video list -->
      <div class="card">
        <div class="card-header">
          <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="2.18"/><line x1="7" y1="2" x2="7" y2="22"/><line x1="17" y1="2" x2="17" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/></svg></div>
          <div class="card-title">Vidéos publiées (<%= videos.length %>)</div>
        </div>
        <div class="card-body">
          <% if (videos.length === 0) { %>
            <div class="empty">Aucune vidéo ajoutée</div>
          <% } else { %>
            <div class="content-list">
              <% videos.forEach(v => { %>
                <div class="content-item">
                  <div class="content-thumb">
                    <% if (v.youtubeId) { %>
                      <img src="https://img.youtube.com/vi/<%= v.youtubeId %>/default.jpg" alt="" loading="lazy" />
                    <% } else { %>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>
                    <% } %>
                  </div>
                  <div class="content-info">
                    <div class="content-title"><%= v.title %></div>
                    <div class="content-meta">
                      <span class="content-cat"><%= v.category %></span>
                      <span class="content-date"><%= new Date(v.createdAt).toLocaleDateString('fr-FR') %></span>
                      <% if (v.youtubeId) { %><span style="font-size:.7rem;color:var(--muted);">YouTube</span><% } else { %><span style="font-size:.7rem;color:var(--muted);">Fichier local</span><% } %>
                    </div>
                  </div>
                  <form method="POST" action="/admin/contenu/delete/<%= v.id %>" onsubmit="return confirm('Supprimer cette vidéo ?')">
                    <button type="submit" class="btn-del">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/></svg>
                    </button>
                  </form>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>
    </div>

    <!-- ── PROGRAMMES PANEL ── -->
    <div class="panel" id="tab-programmes">
      <!-- Add form -->
      <div class="card">
        <div class="card-header">
          <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></div>
          <div class="card-title">Ajouter un programme</div>
        </div>
        <div class="card-body">
          <form method="POST" action="/admin/contenu/add-programme" enctype="multipart/form-data">
            <div class="form-group">
              <label for="ptitle">Titre</label>
              <input type="text" id="ptitle" name="title" required placeholder="Programme musculation 8 semaines" />
            </div>
            <div class="form-group">
              <label for="pcategory">Catégorie</label>
              <input type="text" id="pcategory" name="category" placeholder="Fitness, Arts Martiaux…" />
            </div>
            <div class="form-group">
              <label for="pdesc">Description (optionnel)</label>
              <textarea id="pdesc" name="description" placeholder="Décrivez le programme…"></textarea>
            </div>
            <div class="form-group">
              <label for="programFile" class="file-label">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                Choisir un fichier
              </label>
              <input type="file" id="programFile" name="programFile" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" required onchange="document.getElementById('pFileName').textContent = this.files[0]?.name || ''" />
              <div class="file-name" id="pFileName">PDF, Word, Image — max 100 Mo</div>
            </div>
            <button type="submit" class="btn-save">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              Ajouter le programme
            </button>
          </form>
        </div>
      </div>

      <!-- Programme list -->
      <div class="card">
        <div class="card-header">
          <div class="card-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg></div>
          <div class="card-title">Programmes publiés (<%= programs.length %>)</div>
        </div>
        <div class="card-body">
          <% if (programs.length === 0) { %>
            <div class="empty">Aucun programme ajouté</div>
          <% } else { %>
            <div class="content-list">
              <% programs.forEach(p => { %>
                <div class="content-item">
                  <div class="content-thumb">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                  </div>
                  <div class="content-info">
                    <div class="content-title"><%= p.title %></div>
                    <div class="content-meta">
                      <span class="content-cat"><%= p.category %></span>
                      <span class="content-date"><%= new Date(p.createdAt).toLocaleDateString('fr-FR') %></span>
                      <span style="font-size:.7rem;color:var(--muted);text-transform:uppercase;"><%= p.fileExt %></span>
                    </div>
                  </div>
                  <form method="POST" action="/admin/contenu/delete/<%= p.id %>" onsubmit="return confirm('Supprimer ce programme ?')">
                    <button type="submit" class="btn-del">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6"/></svg>
                    </button>
                  </form>
                </div>
              <% }) %>
            </div>
          <% } %>
        </div>
      </div>
    </div>
  </main>

  <script>
    document.querySelectorAll('.tab').forEach(tab => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
        tab.classList.add('active');
        document.getElementById('tab-' + tab.dataset.tab).classList.add('active');
      });
    });
  </script>
</body>
</html>
